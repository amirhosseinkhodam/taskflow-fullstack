# Database (use DATABASE_URL or individual PG* vars)
# DATABASE_URL=postgresql://user:password@localhost:5432/taskflow
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=taskflow

# JWT — REQUIRED (app will not start without it)
JWT_SECRET=

# CORS — comma-separated origins (default: http://localhost:4200)
# CORS_ORIGIN=http://localhost:4200

# Seed credentials (optional — used by db:seed and startup auto-seed)
# Set these in your local .env if you want to create a Super Admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional regular Admin seed credentials
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional
# NODE_ENV=development
# PORT=3000
